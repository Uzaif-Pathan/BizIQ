{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biziq.local/contracts/analysis-result.schema.json",
  "title": "AnalysisResult",
  "description": "Standard BizIQ analysis response shared by the frontend, analytics engine and API. Money is INR. Percentages are numbers in percent. Metrics that cannot be calculated are null, never 0.",
  "type": "object",
  "required": [
    "analysis_id",
    "business_id",
    "status",
    "metrics",
    "findings",
    "recommendations",
    "evidence_level",
    "benchmark_status"
  ],
  "additionalProperties": false,
  "properties": {
    "analysis_id": { "type": "string", "minLength": 1 },
    "business_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "completed", "failed", "partial"] },
    "metrics": { "$ref": "#/$defs/Metrics" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
    "recommendations": { "type": "array", "items": { "$ref": "#/$defs/Recommendation" } },
    "evidence_level": { "enum": ["insufficient", "low", "medium", "high"] },
    "benchmark_status": { "enum": ["available", "partial", "unavailable"] },
    "method_version": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "error_message": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["errors", "warnings"],
      "properties": {
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "health_score": {
      "type": ["object", "null"],
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "weight", "basis"],
            "properties": {
              "name": { "type": "string" },
              "weight": { "type": ["number", "null"] },
              "value": { "type": ["number", "null"] },
              "direction": { "enum": ["raises", "lowers", "neutral", null] },
              "basis": { "enum": ["measured", "benchmark", "rule"] },
              "base_weight": { "type": "number" },
              "points": { "type": ["number", "null"] },
              "effect_points": { "type": ["number", "null"] },
              "metric": { "type": "string" },
              "explanation": { "type": "string" },
              "benchmark": { "type": "object" }
            }
          }
        },
        "unavailable_components": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "band": { "enum": ["strong", "moderate", "weak", "at risk", null] },
        "coverage_pct": { "type": "number" },
        "raised_by": { "type": "array", "items": { "type": "string" } },
        "lowered_by": { "type": "array", "items": { "type": "string" } },
        "disclaimer": { "type": "string" }
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "segmentation": { "$ref": "#/$defs/model" },
        "forecast": { "$ref": "#/$defs/model" }
      }
    }
  },
  "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
  "then": {
    "required": ["error_message"],
    "properties": { "error_message": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "Metrics": {
      "type": "object",
      "properties": {
        "revenue": { "type": ["number", "null"] },
        "expenses": { "type": ["number", "null"] },
        "profit": { "type": ["number", "null"] },
        "profit_margin": { "type": ["number", "null"] }
      },
      "additionalProperties": { "type": ["number", "null"] }
    },
    "Finding": {
      "type": "object",
      "required": ["finding_id", "category", "title", "description"],
      "additionalProperties": false,
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["financial", "customer", "product", "trend", "benchmark", "data_quality"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "metric_name": { "type": ["string", "null"] },
        "metric_value": { "type": ["number", "null"] },
        "severity": { "enum": ["info", "warning", "critical"], "default": "info" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Recommendation": {
      "type": "object",
      "required": [
        "recommendation_id",
        "title",
        "issue",
        "reason",
        "action",
        "priority",
        "supporting_finding_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "recommendation_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "issue": { "type": "string" },
        "reason": { "type": "string" },
        "action": { "type": "string" },
        "priority": { "enum": ["high", "medium", "low"] },
        "supporting_finding_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "kpi": { "type": ["string", "null"] },
        "supporting_metric": { "type": ["string", "null"] },
        "rationale": { "type": "string" },
        "rule_id": { "type": "string" },
        "expected_direction": {
          "type": ["object", "null"],
          "properties": {
            "metric": { "type": "string" },
            "direction": { "enum": ["increase", "decrease"] }
          }
        },
        "caveat": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ok", "skipped_insufficient_data", "not_applicable", "failed"] },
        "mae": { "type": ["number", "null"] },
        "rmse": { "type": ["number", "null"] },
        "details": { "type": "object" }
      }
    }
  }
}
