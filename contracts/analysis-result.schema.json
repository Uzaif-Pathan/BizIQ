{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biziq/analysis-result.schema.json",
  "title": "BizIQ analysis result",
  "description": "Output of analytics_engine.run_analysis(). Money in INR as numbers, months YYYY-MM, percentages as percent numbers (23.29 = 23.29%), missing = null (never 0).",
  "type": "object",
  "required": [
    "analysis_id",
    "business_id",
    "status",
    "evidence_level",
    "benchmark_status",
    "validation",
    "metrics",
    "findings",
    "recommendations"
  ],
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "evidence_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "benchmark_status": {
      "enum": [
        "available",
        "partial",
        "unavailable"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "errors",
        "warnings"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metric"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "health_score": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "weight",
              "basis"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "direction": {
                "enum": [
                  "raises",
                  "lowers",
                  "neutral"
                ]
              },
              "basis": {
                "enum": [
                  "measured",
                  "benchmark",
                  "rule"
                ]
              }
            }
          }
        },
        "unavailable_components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "segmentation": {
          "$ref": "#/$defs/model"
        },
        "forecast": {
          "$ref": "#/$defs/model"
        }
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "dataset": {
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why value is null."
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "description": "Caveat for a value that WAS computed (e.g. based on 10 of 12 months)."
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "type",
        "metric",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "comparison": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "id",
        "finding_ids",
        "issue",
        "action",
        "priority",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "issue": {
          "type": "string"
        },
        "supporting_metric": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "kpi": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "skipped_insufficient_data",
            "not_applicable",
            "failed"
          ]
        },
        "mae": {
          "type": [
            "number",
            "null"
          ]
        },
        "rmse": {
          "type": [
            "number",
            "null"
          ]
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
