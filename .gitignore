!data/samples/**/*.csv
!data/samples/**/*.json
# Reference data (benchmark tables) that the app loads
!database/reference_data/
!database/reference_data/*.csv

# Generated model artifacts
model_artifacts/*
!model_artifacts/README.md
!model_artifacts/.gitkeep
*.joblib
*.pkl
*.pickle

